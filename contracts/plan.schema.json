{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "plan",
  "type": "object",
  "properties": {
    "job_id": {
      "type": "string"
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_-]{2,32}$"
          },
          "repo_url": {
            "type": "string"
          },
          "commit_sha": {
            "type": [
              "string",
              "null"
            ],
            "default": "HEAD"
          },
          "task_type": {
            "enum": [
              "batch",
              "service"
            ]
          },
          "is_mcp_server": {
            "type": "boolean",
            "default": false
          },
          "mcp_transport_native": {
            "enum": [
              "stdio",
              "streamable_http",
              "sse",
              "none"
            ],
            "default": "none"
          },
          "start_cmd_override": {
            "type": [
              "string",
              "null"
            ],
            "default": null
          },
          "env_keys_required": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": []
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": []
          },
          "est_ram_mb": {
            "type": "integer",
            "minimum": 128,
            "maximum": 16384,
            "default": 512
          },
          "est_cpus": {
            "type": "number",
            "minimum": 0.25,
            "maximum": 4,
            "default": 1
          },
          "priority": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10,
            "default": 5
          },
          "idle_ttl_sec": {
            "type": "integer",
            "default": 900
          },
          "timeout_sec": {
            "type": "integer",
            "default": 600
          }
        },
        "required": [
          "id",
          "repo_url",
          "task_type"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "job_id",
    "tasks"
  ],
  "additionalProperties": false
}
